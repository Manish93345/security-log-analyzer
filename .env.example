# ---------------------------------------------------------------------------
# slrag configuration — copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# one of: groq | gemini | openrouter | ollama | openai
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Free API keys (no credit card required):
#   Groq    → https://console.groq.com/keys
#   Gemini  → https://aistudio.google.com/app/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Local fallback (no key, works offline). Requires `ollama serve` + `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Fallback provider (used automatically when the primary returns 429) ---
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash

# --- Embeddings ------------------------------------------------------------
# fastembed (default, ONNX, ~90MB, no torch) | sentence_transformers | openai
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranker --------------------------------------------------------------
RERANK_ENABLED=true
RERANK_MODEL=ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=50
RETRIEVE_TOP_K=5

# --- Paths -----------------------------------------------------------------
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
CHROMA_DIR=data/chroma
SQLITE_PATH=data/processed/events.sqlite
CACHE_DIR=data/cache
REPORTS_DIR=reports

# --- Guardrails ------------------------------------------------------------
GUARDRAILS_ENABLED=true
MAX_PROMPT_TOKENS=12000
REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=4

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
